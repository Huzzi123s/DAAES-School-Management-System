# Copy this file to .env and change the values.

# development | production
FLASK_ENV=development

# Use long random strings in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_EXPIRES_HOURS=12

# SQLite is used when DATABASE_URL is empty.
# MySQL (XAMPP) example:
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/daaes_school
DATABASE_URL=

# Comma separated list of allowed frontend origins, or * for all.
CORS_ORIGINS=http://localhost,http://127.0.0.1

MAX_UPLOAD_MB=5

HOST=127.0.0.1
PORT=5000
